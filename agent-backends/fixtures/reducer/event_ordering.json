{
  "scenario": "reordered unique event IDs do not regress runtime, while duplicate delivery is idempotent",
  "adapter": "mock-agent",
  "profileId": "11111111-1111-4111-8111-111111111111",
  "hostInstanceId": "33333333-3333-4333-8333-333333333333",
  "steps": [
    {
      "apply": {
        "kind": "structured",
        "pane": 7,
        "host": "33333333-3333-4333-8333-333333333333",
        "envelope": {
          "v": 1,
          "eventId": "evt-0002",
          "adapter": "mock-agent",
          "profileId": "11111111-1111-4111-8111-111111111111",
          "event": "session_start",
          "sessionId": "mock-1-0",
          "cwd": "C:\\work\\mock",
          "transcriptPath": null,
          "occurredAt": "2026-08-06T00:00:02Z",
          "data": { "seq": 2 }
        }
      },
      "expect": "attach:mock-1-0:g1"
    },
    {
      "apply": {
        "kind": "structured",
        "pane": 7,
        "host": "33333333-3333-4333-8333-333333333333",
        "envelope": {
          "v": 1,
          "eventId": "evt-0001",
          "adapter": "mock-agent",
          "profileId": "11111111-1111-4111-8111-111111111111",
          "event": "prompt_submit",
          "sessionId": "mock-1-0",
          "cwd": "C:\\work\\mock",
          "transcriptPath": null,
          "occurredAt": "2026-08-06T00:00:01Z",
          "data": { "seq": 1, "turn": 1, "text": "late" }
        }
      },
      "expect": "out-of-order:mock-1-0"
    },
    {
      "apply": {
        "kind": "structured",
        "pane": 7,
        "host": "33333333-3333-4333-8333-333333333333",
        "envelope": {
          "v": 1,
          "eventId": "evt-0003",
          "adapter": "mock-agent",
          "profileId": "11111111-1111-4111-8111-111111111111",
          "event": "turn_complete",
          "sessionId": "mock-1-0",
          "cwd": "C:\\work\\mock",
          "transcriptPath": null,
          "occurredAt": "2026-08-06T00:00:03Z",
          "data": { "seq": 3, "turn": 1 }
        }
      },
      "expect": "runtime:mock-1-0@waiting_for_input"
    },
    {
      "apply": {
        "kind": "structured",
        "pane": 7,
        "host": "33333333-3333-4333-8333-333333333333",
        "envelope": {
          "v": 1,
          "eventId": "evt-0003",
          "adapter": "mock-agent",
          "profileId": "11111111-1111-4111-8111-111111111111",
          "event": "turn_complete",
          "sessionId": "mock-1-0",
          "cwd": "C:\\work\\mock",
          "transcriptPath": null,
          "occurredAt": "2026-08-06T00:00:03Z",
          "data": { "seq": 3, "turn": 1 }
        }
      },
      "expect": "duplicate"
    }
  ],
  "final": {
    "conversations": {
      "mock-1-0": {
        "runtime": "waiting_for_input",
        "ended": false,
        "detachReason": null
      }
