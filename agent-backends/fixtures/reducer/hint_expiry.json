{
  "scenario": "candidate expiry after the 30s injected-clock window leaves the binding unchanged",
  "adapter": "mock-agent",
  "profileId": "11111111-1111-4111-8111-111111111111",
  "hostInstanceId": "33333333-3333-4333-8333-333333333333",
  "steps": [
    {
      "apply": {
        "kind": "structured",
        "pane": 7,
        "host": "33333333-3333-4333-8333-333333333333",
        "envelope": {
          "v": 1,
          "eventId": "evt-0001",
          "adapter": "mock-agent",
          "profileId": "11111111-1111-4111-8111-111111111111",
          "event": "session_start",
          "sessionId": "mock-1-0",
          "cwd": "C:\\work\\mock",
